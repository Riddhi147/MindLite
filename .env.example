# Neon pooled PostgreSQL connection string. Keep sslmode=require if supplied.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Public URL of the deployed FastAPI function. For one Vercel project, use
# https://YOUR-VERCEL-DOMAIN.vercel.app/api
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS="http://localhost:3000"

# Optional SMTP configuration for the caregiver-email endpoint.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
